def tempo_personalizado(valor):
    try:
        partes = valor.strip().split(":")
        if len(partes) == 2:
            return pd.to_timedelta(f"{int(partes[0])}:{int(partes[1])}:00")
        elif len(partes) == 3:
            return pd.to_timedelta(valor)
        else:
            return pd.NaT
    except (ValueError, AttributeError):
        return pd.NaT

